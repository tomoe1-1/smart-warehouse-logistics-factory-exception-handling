{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/inbound/[system]",
      "regex": "^/api/inbound/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsystem": "nxtPsystem"
      },
      "namedRegex": "^/api/inbound/(?<nxtPsystem>[^/]+?)(?:/)?$"
    },
    {
      "page": "/loop/[id]",
      "regex": "^/loop/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/loop/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/loop/[id].segments/loop/$d$id$segment",
          "source": "^/loop/(?<nxtPid>[^/]+?)\\.segments/loop/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/adapters",
      "regex": "^/adapters(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/adapters(?:/)?$"
    },
    {
      "page": "/api/adapters/bridge",
      "regex": "^/api/adapters/bridge(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/adapters/bridge(?:/)?$"
    },
    {
      "page": "/api/assistant/apply",
      "regex": "^/api/assistant/apply(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/assistant/apply(?:/)?$"
    },
    {
      "page": "/api/assistant/chat",
      "regex": "^/api/assistant/chat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/assistant/chat(?:/)?$"
    },
    {
      "page": "/api/assistant/diagnose",
      "regex": "^/api/assistant/diagnose(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/assistant/diagnose(?:/)?$"
    },
    {
      "page": "/api/assistant/status",
      "regex": "^/api/assistant/status(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/assistant/status(?:/)?$"
    },
    {
      "page": "/api/inbound/queue",
      "regex": "^/api/inbound/queue(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/inbound/queue(?:/)?$"
    },
    {
      "page": "/api/inbound/simulate",
      "regex": "^/api/inbound/simulate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/inbound/simulate(?:/)?$"
    },
    {
      "page": "/api/site-config",
      "regex": "^/api/site\\-config(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/site\\-config(?:/)?$"
    },
    {
      "page": "/api/site-config/test",
      "regex": "^/api/site\\-config/test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/site\\-config/test(?:/)?$"
    },
    {
      "page": "/api/state",
      "regex": "^/api/state(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/state(?:/)?$"
    },
    {
      "page": "/assistant",
      "regex": "^/assistant(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/assistant(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/loop",
      "regex": "^/loop(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/loop(?:/)?$"
    },
    {
      "page": "/rules",
      "regex": "^/rules(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rules(?:/)?$"
    },
    {
      "page": "/setup",
      "regex": "^/setup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/setup(?:/)?$"
    },
    {
      "page": "/skills",
      "regex": "^/skills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skills(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": true,
    "dynamicRSCPrerender": true
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "ppr": {
    "chain": {
      "headers": {
        "next-resume": "1"
      }
    }
  }
}